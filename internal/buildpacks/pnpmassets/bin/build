#!/usr/bin/env bash

set -euo pipefail

script="${BP_DEPLOYCRATE_FRONTEND_SCRIPT:-}"
if [[ ! "${script}" =~ ^[A-Za-z0-9][A-Za-z0-9:_-]{0,63}$ ]]; then
  echo "DeployCrate frontend script must be a package script name" >&2
  exit 1
fi

buildpack_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
default_pnpm_version="$(sed -n 's/^default-pnpm-version = "\([^"]*\)"$/\1/p' "${buildpack_root}/buildpack.toml")"
if [[ ! "${default_pnpm_version}" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]]; then
  echo "DeployCrate pnpm Assets has an invalid default pnpm version" >&2
  exit 1
fi

package_manager="$(node -e 'const value = require("./package.json").packageManager; process.stdout.write(typeof value === "string" ? value.trim() : "")')"
pnpm_version="${default_pnpm_version}"
if [[ -n "${package_manager}" ]]; then
  if [[ ! "${package_manager}" =~ ^pnpm@([0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?)(\+sha(224|512)\.[0-9A-Za-z+/=_-]+)?$ ]]; then
    echo "package.json packageManager must be absent or pin an exact pnpm version" >&2
    exit 1
  fi
  pnpm_version="${BASH_REMATCH[1]}"
fi

if ! node -e 'const manifest = require("./package.json"); const script = process.env.BP_DEPLOYCRATE_FRONTEND_SCRIPT; process.exit(manifest.scripts && typeof manifest.scripts[script] === "string" && manifest.scripts[script].trim() ? 0 : 1)'; then
  echo "package.json must define the ${script} script" >&2
  exit 1
fi

for incompatible in package-lock.json npm-shrinkwrap.json yarn.lock bun.lock bun.lockb; do
  if [[ -e "${incompatible}" ]]; then
    echo "Node asset context cannot contain both pnpm-lock.yaml and ${incompatible}" >&2
    exit 1
  fi
done

cache_layer="${CNB_LAYERS_DIR}/pnpm-cache"
mkdir -p "${cache_layer}/npm" "${cache_layer}/store"
cat > "${CNB_LAYERS_DIR}/pnpm-cache.toml" <<'LAYER'
[types]
build = false
cache = true
launch = false
LAYER

export CI=true
export npm_config_cache="${cache_layer}/npm"
export npm_config_store_dir="${cache_layer}/store"

pnpm_layer="${CNB_LAYERS_DIR}/pnpm"
installed_pnpm_version=""
if [[ -f "${pnpm_layer}/version" ]]; then
  installed_pnpm_version="$(<"${pnpm_layer}/version")"
fi
if [[ "${installed_pnpm_version}" != "${pnpm_version}" || ! -x "${pnpm_layer}/bin/pnpm" ]]; then
  echo "DeployCrate pnpm Assets Buildpack"
  echo "  Installing pnpm ${pnpm_version}"
  rm -rf "${pnpm_layer}"
  mkdir -p "${pnpm_layer}"
  npm install --global --prefix "${pnpm_layer}" --ignore-scripts --no-audit --no-fund "pnpm@${pnpm_version}"
  printf '%s' "${pnpm_version}" > "${pnpm_layer}/version"
else
  echo "DeployCrate pnpm Assets Buildpack"
  echo "  Reusing pnpm ${pnpm_version}"
fi
cat > "${CNB_LAYERS_DIR}/pnpm.toml" <<LAYER
[types]
build = true
cache = true
launch = false

[metadata]
version = "${pnpm_version}"
LAYER
export PATH="${pnpm_layer}/bin:${PATH}"

cleanup() {
  find . -type d -name node_modules -prune -exec rm -rf -- '{}' +
}
trap cleanup EXIT

echo "  Installing dependencies from pnpm-lock.yaml"
pnpm install --frozen-lockfile

echo "  Running package script: ${script}"
pnpm run "${script}"
