#!/usr/bin/env bash

set -euo pipefail

if [[ -z "${BP_DEPLOYCRATE_FRONTEND_SCRIPT:-}" ]]; then
  exit 100
fi

if [[ ! -f package.json ]]; then
  echo "DeployCrate pnpm Assets requires package.json" >&2
  exit 1
fi

if [[ ! -f pnpm-lock.yaml ]]; then
  echo "DeployCrate pnpm Assets requires pnpm-lock.yaml" >&2
  exit 1
fi

cat > "${CNB_BUILD_PLAN_PATH}" <<'PLAN'
[[requires]]
name = "node"

[requires.metadata]
build = true
launch = false

[[requires]]
name = "npm"

[requires.metadata]
build = true
launch = false
PLAN
