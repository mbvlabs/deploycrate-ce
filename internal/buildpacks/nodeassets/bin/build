#!/usr/bin/env bash

set -euo pipefail

script="${BP_DEPLOYCRATE_FRONTEND_SCRIPT:-}"
if [[ ! "${script}" =~ ^[A-Za-z0-9][A-Za-z0-9:_-]{0,63}$ ]]; then
  echo "DeployCrate frontend script must be a package script name" >&2
  exit 1
fi
if [[ ! -f package.json ]]; then
  echo "DeployCrate Node Assets requires package.json" >&2
  exit 1
fi

supported_lockfiles=(package-lock.json npm-shrinkwrap.json pnpm-lock.yaml bun.lock bun.lockb)
found_lockfiles=()
for candidate in "${supported_lockfiles[@]}"; do
  if [[ -f "${candidate}" ]]; then
    found_lockfiles+=("${candidate}")
  fi
done
if (( ${#found_lockfiles[@]} == 0 )); then
  echo "DeployCrate Node Assets requires one lockfile: package-lock.json, npm-shrinkwrap.json, pnpm-lock.yaml, bun.lock, or bun.lockb" >&2
  exit 1
fi
if (( ${#found_lockfiles[@]} > 1 )); then
  printf -v conflicts '%s, ' "${found_lockfiles[@]}"
  conflicts="${conflicts%, }"
  echo "DeployCrate Node Assets found multiple lockfiles: ${conflicts}. Keep only the lockfile for the package manager used by this project." >&2
  exit 1
fi

lockfile="${found_lockfiles[0]}"
case "${lockfile}" in
  package-lock.json|npm-shrinkwrap.json) manager="npm" ;;
  pnpm-lock.yaml) manager="pnpm" ;;
  bun.lock|bun.lockb) manager="bun" ;;
  *) echo "DeployCrate Node Assets could not identify the package manager" >&2; exit 1 ;;
esac

if ! node -e 'const manifest = require("./package.json"); const script = process.env.BP_DEPLOYCRATE_FRONTEND_SCRIPT; process.exit(manifest.scripts && typeof manifest.scripts[script] === "string" && manifest.scripts[script].trim() ? 0 : 1)'; then
  echo "package.json must define a non-empty ${script} script" >&2
  exit 1
fi

buildpack_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
default_version="$(sed -n "s/^default-${manager}-version = \"\([^\"]*\)\"$/\1/p" "${buildpack_root}/buildpack.toml")"
if [[ ! "${default_version}" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]]; then
  echo "DeployCrate Node Assets has an invalid default ${manager} version" >&2
  exit 1
fi

manager_version="${default_version}"
if ! package_manager_result="$(node -e 'const manifest = require("./package.json"); if (!Object.prototype.hasOwnProperty.call(manifest, "packageManager")) { process.stdout.write("0"); } else if (typeof manifest.packageManager === "string") { process.stdout.write(`1${manifest.packageManager.trim()}`); } else { process.exit(1); }')"; then
  echo "package.json packageManager must pin an exact npm, pnpm, or bun version" >&2
  exit 1
fi
if [[ "${package_manager_result:0:1}" == "1" ]]; then
  package_manager="${package_manager_result:1}"
  if [[ ! "${package_manager}" =~ ^([A-Za-z0-9_-]+)@([0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?)(\+sha(224|512)\.[0-9A-Za-z+/=_-]+)?$ ]]; then
    echo "package.json packageManager must pin an exact npm, pnpm, or bun version" >&2
    exit 1
  fi
  declared_manager="${BASH_REMATCH[1]}"
  manager_version="${BASH_REMATCH[2]}"
  if [[ "${declared_manager}" != "${manager}" ]]; then
    echo "package.json packageManager selects ${declared_manager}, but ${lockfile} selects ${manager}" >&2
    exit 1
  fi
fi

case "${manager}" in
  npm)
    install_command="npm ci"
    build_command="npm run ${script}"
    ;;
  pnpm)
    install_command="pnpm install --frozen-lockfile"
    build_command="pnpm run ${script}"
    ;;
  bun)
    install_command="bun install --frozen-lockfile"
    build_command="bun run ${script}"
    ;;
esac

echo "DeployCrate Node Assets Buildpack"
echo "  Package manager: ${manager} ${manager_version}"
echo "  Lockfile: ${lockfile}"
echo "  Install command: ${install_command}"
echo "  Build command: ${build_command}"

cache_layer="${CNB_LAYERS_DIR}/${manager}-cache"
mkdir -p "${cache_layer}/bootstrap" "${cache_layer}/store"
cat > "${CNB_LAYERS_DIR}/${manager}-cache.toml" <<LAYER
[types]
build = false
cache = true
launch = false

[metadata]
manager = "${manager}"
LAYER

export CI=true
export npm_config_cache="${cache_layer}/bootstrap"
case "${manager}" in
  npm) export npm_config_cache="${cache_layer}/store" ;;
  pnpm) export npm_config_store_dir="${cache_layer}/store" ;;
  bun) export BUN_INSTALL_CACHE_DIR="${cache_layer}/store" ;;
esac

tool_layer="${CNB_LAYERS_DIR}/${manager}"
installed_version=""
if [[ -f "${tool_layer}/version" ]]; then
  installed_version="$(<"${tool_layer}/version")"
fi
if [[ "${installed_version}" != "${manager_version}" || ! -x "${tool_layer}/bin/${manager}" ]]; then
  echo "  Installing ${manager} ${manager_version}"
  rm -rf "${tool_layer}"
  mkdir -p "${tool_layer}"
  npm install --global --prefix "${tool_layer}" --ignore-scripts --no-audit --no-fund "${manager}@${manager_version}"
  printf '%s' "${manager_version}" > "${tool_layer}/version"
else
  echo "  Reusing ${manager} ${manager_version}"
fi
cat > "${CNB_LAYERS_DIR}/${manager}.toml" <<LAYER
[types]
build = true
cache = true
launch = false

[metadata]
version = "${manager_version}"
LAYER
export PATH="${tool_layer}/bin:${PATH}"

cleanup() {
  find . -type d -name node_modules -prune -exec rm -rf -- '{}' +
}
trap cleanup EXIT

case "${manager}" in
  npm)
    npm ci
    npm run "${script}"
    ;;
  pnpm)
    pnpm install --frozen-lockfile
    pnpm run "${script}"
    ;;
  bun)
    bun install --frozen-lockfile
    bun run "${script}"
    ;;
esac
