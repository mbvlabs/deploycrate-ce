#!/usr/bin/env bash

set -euo pipefail

if [[ -z "${BP_DEPLOYCRATE_FRONTEND_SCRIPTS:-}" ]]; then
  exit 100
fi

asset_directory="${BP_DEPLOYCRATE_FRONTEND_DIRECTORY:-.}"
if [[ "${asset_directory}" == /* || "${asset_directory}" == ".." || "${asset_directory}" == ../* || "${asset_directory}" == */../* ]]; then
  echo "DeployCrate frontend directory must stay inside the build context" >&2
  exit 1
fi
if ! cd "${asset_directory}"; then
  echo "DeployCrate frontend directory does not exist: ${asset_directory}" >&2
  exit 1
fi

if [[ ! -f package.json ]]; then
  echo "DeployCrate Node Assets requires package.json in ${asset_directory}" >&2
  exit 1
fi

supported_lockfiles=(package-lock.json npm-shrinkwrap.json pnpm-lock.yaml yarn.lock bun.lock bun.lockb)
found_lockfiles=()
for lockfile in "${supported_lockfiles[@]}"; do
  if [[ -f "${lockfile}" ]]; then
    found_lockfiles+=("${lockfile}")
  fi
done

if (( ${#found_lockfiles[@]} == 0 )); then
  echo "DeployCrate Node Assets requires one lockfile: package-lock.json, npm-shrinkwrap.json, pnpm-lock.yaml, yarn.lock, bun.lock, or bun.lockb" >&2
  exit 1
fi
if (( ${#found_lockfiles[@]} > 1 )); then
  printf -v conflicts '%s, ' "${found_lockfiles[@]}"
  conflicts="${conflicts%, }"
  echo "DeployCrate Node Assets found multiple lockfiles: ${conflicts}. Keep only the lockfile for the package manager used by this project." >&2
  exit 1
fi

launch_node=false
if [[ "${BP_DEPLOYCRATE_KEEP_NODE_RUNTIME:-}" == "true" ]]; then
  launch_node=true
fi

cat > "${CNB_BUILD_PLAN_PATH}" <<PLAN
[[requires]]
name = "node"

[requires.metadata]
build = true
launch = ${launch_node}

[[requires]]
name = "npm"

[requires.metadata]
build = true
launch = false
PLAN
