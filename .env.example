ENVIRONMENT=development

DEFAULT_SENDER_SIGNATURE=info@andurel.com

DB_KIND=postgres
DB_PORT=5432
DB_HOST=127.0.0.1
DB_NAME=andurel
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL_MODE=disable

PROJECT_NAME=deploycrate-ce
DOMAIN=localhost:8080
PROTOCOL=http

SESSION_KEY=<generate-a-random-64-byte-hex-value>
SESSION_ENCRYPTION_KEY=<generate-a-random-32-byte-hex-value>
SESSION_MAX_AGE=604800

TOKEN_SIGNING_KEY=<generate-a-random-32-byte-hex-value>

SSH_CA_USER_PRIVATE_KEY_PATH=/var/lib/deploycrate/ssh-ca/user-ca
SSH_CA_HOST_PRIVATE_KEY_PATH=/var/lib/deploycrate/ssh-ca/host-ca
SSH_CA_USER_PRINCIPAL=admin
SSH_CA_SOURCE_CIDR=10.99.0.1/32
SSH_CA_USER_VALIDITY=30m

CORS_ALLOWED_ORIGINS=
CSRF_STRATEGY=header_only
CSRF_TRUSTED_ORIGINS=

PEPPER=<generate-a-random-secret>
PREVIOUS_PEPPERS=

DEPLOYCRATE_CE_UPDATE_CHANNEL=edge
DEPLOYCRATE_CE_RELEASE_BASE_URL=https://get-dev.deploycrate.com

METRICS_ROLLUP_ENABLED=false
PROMETHEUS_URL=http://127.0.0.1:9090
TELEMETRY_SERVICE_NAME=deploycrate-ce
TELEMETRY_SERVICE_NAMESPACE=deploycrate-ce
OTLP_LOGS_ENDPOINT=http://127.0.0.1:4318/v1/logs
OTLP_METRICS_ENDPOINT=http://127.0.0.1:4318/v1/metrics
OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
CLICKHOUSE_PROTOCOL=http
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=deploycrate
CLICKHOUSE_USER=deploycrate
CLICKHOUSE_PASSWORD=

AWS_REGION=us-east-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_CONFIGURATION_SET=

INSTANCE_ID=<generate-a-uuid>
